region                = "ap-south-1"
environment           = "prod"
acm_certificate_arn   = "arn:aws:acm:ap-south-1:123456789012:certificate/replace-me"
github_repository     = "your-org/gymops"
alarm_email           = "oncall@example.com"
bootstrap_admin_email = "superadmin@example.com"

