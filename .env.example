# Copy to .env (or run `make env` to generate strong random secrets). Never commit .env.
POSTGRES_DB=gymops
POSTGRES_USER=gymops
POSTGRES_PASSWORD=change-me
ANALYTICS_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# >= 32 characters; shared by core (signing) and analytics (verification)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
BOOTSTRAP_ADMIN_EMAIL=superadmin@gymops.dev
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-12-chars
# Demo dataset (local only)
DEMO_DATA_ENABLED=true
DEMO_USER_PASSWORD=change-me-min-10-chars
BUSINESS_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Payments: "simulated" (default, no real money) or "razorpay" (test or live keys from the Razorpay dashboard)
PAYMENT_GATEWAY=simulated
SIMULATED_GATEWAY_SECRET=change-me-signs-simulated-checkouts-and-webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Access control: master key (>= 32 chars) that derives every gate device's HMAC secret and the QR entry-pass key.
# Required with the prod profile. Changing it invalidates all device secrets (re-provision gates) and live QR codes.
ACCESS_MASTER_KEY=change-me-derives-gate-device-secrets-and-qr-passes
# E-mail: "smtp" (docker compose default: local Mailpit inbox at http://localhost:8025) or "log" (no e-mail sent).
# Production: Amazon SES SMTP (email-smtp.<region>.amazonaws.com:587), SendGrid (smtp.sendgrid.net:587, user "apikey")
# or Gmail (smtp.gmail.com:587 + app password). Leave SMTP_HOST/PORT empty locally to use Mailpit.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS_REQUIRED=false
MAIL_FROM_ADDRESS=no-reply@gymops.local
MAIL_FROM_NAME=GymOps
# Public URL of the web app (links in e-mails: preferences, unsubscribe)
PUBLIC_BASE_URL=http://localhost
# Signs one-click unsubscribe links (derived from JWT_SECRET when empty)
UNSUBSCRIBE_TOKEN_SECRET=change-me-signs-unsubscribe-links
# SMS: "log" (default, nothing sent), "twilio" or "msg91" (India, DLT templates)
SMS_PROVIDER=log
SMS_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_DLT_TEMPLATE_ID=
